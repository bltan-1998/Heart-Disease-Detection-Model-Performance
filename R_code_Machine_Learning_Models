# Bayesian Logit
## set priors (from logit above)
m_coe<-bcoe
sd_coe<-bsd #or summary(model)$coefficients[, "Std. Error"]
prior_int <- normal(m_coe[1], sd_coe[1])
prior_b <- normal(m_coe[-1], sd_coe[-1])
SEED=123

## build the model
folds <- cut(seq(1, nrow(train_data)), breaks = 10, labels = FALSE)
thresholds <- seq(0.1, 0.9, by = 0.1)
youden_scores1 <- numeric(length(thresholds))
sens_spec <- matrix(0,length(thresholds),2)
B <- matrix(0,10,4)

for (i in 1:10) {
  # Split folds
  testIndexes <- which(folds == i, arr.ind = TRUE)
  cv_train <- train_data[-testIndexes, ]
  cv_test  <- X_train[testIndexes, ]
  cv_y <- Y_train[testIndexes]
  
  #model training on priors
  cv_model <- bmodel <- stan_glm(class ~., data = train_data, family = binomial(link = "logit"),prior = prior_b,               prior_intercept =  prior_int, QR=TRUE,seed = SEED, refresh=0)
  
  # Fit inside CV
  for (t in seq_along(thresholds)) {
    th <- thresholds[t]
    preds <- predict(cv_model, newdata = cv_test, type = "response")
    pred_class <- ifelse(preds >= th, 1, 0)
    actual_class <- cv_y
    
    # Sensitivity & specificity
    cm <- table(factor(cv_y, levels=c(0,1)),factor(pred_class, levels=c(0,1)))
    sens <- cm[2,2] / sum(cm[2,])
    spec <- cm[1,1] / sum(cm[1,])
    
    sens_spec [t,]<- c(sens, spec)
    youden_scores1[t] <- sens + spec - 1
    
  }

  #Record best Youden's J Score for each iteration in Matrix B
  best <- c(i,thresholds[which.max(youden_scores1)], sens_spec[which.max(youden_scores1),])
  B[i,] <- best
}

youden_scores <- B[,3]+B[,4]-1
best_thresh <- B[which.max(youden_scores),2]
cat("Best threshold from CV:", best_thresh, "\n")

p_probs <- posterior_epred(bmodel, newdata = as.data.frame(X_test)) 

#Set probability treshold
p_mean <- apply(p_probs, 2, mean)

#Classification
