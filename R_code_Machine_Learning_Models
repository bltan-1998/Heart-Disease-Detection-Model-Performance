#...
data(heart)
H<-heart[,c(-1,-2,-4,-5,-6,-7,-9,-11)] #shall check why are we removing certain columns
#Turn each element to numbers
H$cp<-as.numeric(heart$cp)
H$thalach<-as.numeric(heart$thalach)
H$oldpeak<-as.numeric(heart$oldpeak)
H$ca<-as.numeric(heart$ca)
H$thal<-as.numeric(heart$thal)

#Generate distribution for each column from collected database
m <-colMeans(H[,-6], na.rm = TRUE)
std <-diag(var(H[,-6]))

#Load train-test data
H1 <- read.csv(file.choose(), header=TRUE)#choose heart_train.csv
H2 <- read.csv(file.choose(), header=TRUE)#choose heart_test.csv

#Normalize data to Z-distribution for each database
H1$cp<-(H1$cp-m[1])/std[1]
H1$thalach<-(H1$thalach-m[2])/std[2]
H1$oldpeak<-(H1$oldpeak-m[3])/std[3]
H1$ca<-(H1$ca-m[4])/std[4]
H1$thal<-(H1$thal-m[5])/std[5]

H2$cp<-(H2$cp-m[1])/std[1]
H2$thalach<-(H2$thalach-m[2])/std[2]
H2$oldpeak<-(H2$oldpeak-m[3])/std[3]
H2$ca<-(H2$ca-m[4])/std[4]
H2$thal<-(H2$thal-m[5])/std[5]

#Train-test data split
X_train <- H1[,-6]
X_test <-H2[,-6]
Y_train <- H1$class
Y_test <- H2$class
train_data <-H1

############################################################################################################################
# Logistic regression 
model <- glm(class ~ ., data = train_data, family = "binomial")
folds <- cut(seq(1, nrow(train_data)), breaks = 10, labels = FALSE)
thresholds <- seq(0.1, 0.9, by = 0.1)
youden_scores1 <- numeric(length(thresholds))
sens_spec <- matrix(0,length(thresholds),2)
coef <- matrix(0,10,6)
b_sd <- matrix(0,10,6)
B <- matrix(0,10,4)

#Start 10-folds cross validation to find optimal treshold
for (i in 1:10) {
  # Split train data into 10 folds
  ttIndexes <- which(folds == i, arr.ind = TRUE)
  cv_train <- train_data[-ttIndexes, ]
  cv_test  <- X_train[ttIndexes, ]
  cv_y <- Y_train[ttIndexes]
  
  #model training
  cv_model <- glm(class ~ ., data = cv_train, family = "binomial")
  
  #Find the best threshold for fold i from the treshold array (0.1:0.1:0.9), 
  #we are trying one by one and find the threshold with highest youden's J score
  for (t in seq_along(thresholds)) {
    th <- thresholds[t]
    preds <- predict(cv_model, newdata = cv_test, type = "response")
    pred_class <- ifelse(preds >= th, 1, 0)
    actual_class <- cv_y
    
    # Sensitivity & Specificity 
    cm <- table(factor(cv_y, levels=c(0,1)),factor(pred_class, levels=c(0,1)))
    sens <- cm[2,2] / sum(cm[2,])
    spec <- cm[1,1] / sum(cm[1,])

    #Youden J Score Generation
    sens_spec [t,]<- c(sens, spec)
    youden_scores1[t] <- sens + spec - 1
    
  }

  #best columns are (fold_i, chosen threshold, respective sensitivity & specificity)
  best <- c(i,thresholds[which.max(youden_scores1)], sens_spec[which.max(youden_scores1),])

  #We insert the best to the matrix B so that later we can find out the best threshold from another Youden J score analysis    below  
  B[i,] <- best
  coef[i,] <-cv_model$coefficients#will be used in Bayesian logit
  b_sd[i,] <- sqrt(diag(vcov(cv_model)))
}

youden_scores <- B[,3]+B[,4]-1

#The best threshold
best_thresh <- B[which.max(youden_scores),2]

cat("Best threshold from CV:", best_thresh, "\n")###record the value###
bcoe <- coef[which.max(youden_scores),]#will be used in Bayesian logit
bsd <- b_sd[which.max(youden_scores),]#will be used in Bayesian logit
predictions <- predict(model, newdata = as.data.frame(X_test), type = "response")#testing
binary_predictionslog <- ifelse(predictions >= best_thresh, 1, 0)#check the treshold of prediction to be qualified as 1
resultlog <- data.frame(actual = Y_test, predicted = binary_predictionslog)
accuracylog<-sum(resultlog$actual==resultlog$predicted)/length(resultlog$actual)
print(accuracylog)

#Confusion Matrix & ROC Curve + AUC Value
cmlogit<-confusionMatrix(data = as.factor(binary_predictionslog), reference = as.factor(Y_test), positive = "1")#compare TP,TN,FP,FN,should have 4 blocks only
sen_spe_log<-cmlogit$byClass[c(1,2)]#sensitivity(p(accept|actual =1)) & specitivity(p(exclude|actual =0))
roc_objlog <- roc(Y_test, as.numeric(resultlog$predicted))#roc,auc
AUC<-auc(roc_objlog)#roc,auc
CI_auclog<-ci.auc(roc_objlog, method="bootstrap", boot.n=1000) 
plot(1-roc_objlog$specificities,roc_objlog$sensitivities,type = "l",col="red",lty=1, xlab="1-specificity",ylab = "sensitivity", led=2, xlim=c(0,1), ylim=c(0,1),main = "ROC Curve")#roc,auc
abline(a = 0, b = 1, lty = 2, col = "gray")
text(0.6, 0.2, labels=paste0("AUC = ", round(AUC,3), " (95% CI: ", round(CI_auclog[1],3), "-", round(CI_auclog[3],3),")"))

