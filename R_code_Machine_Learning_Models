plot(1-roc_obj$specificities,roc_obj$sensitivities,type = "l",col="red",lty=1, xlab="1-specificity",ylab = "sensitivity", led=2, xlim=c(0,1), ylim=c(0,1),main = "ROC Curve")#roc,auc
abline(a = 0, b = 1, lty = 2, col = "gray")
text(0.6, 0.2, paste("AUC =", round(AUC, 3)), cex = 1.1, col = "blue")

