#Construct Correlation Matrix
#Construct Correlation Matrix
C0 = H.corr(method='pearson') # pearson correlation matrix
C1 = H.corr(method='spearman') # spearman correlation matrix
# Create mask for lower triangle + diagonal
mask0 = np.tril(np.ones_like(C0, dtype=bool), k=0) # k=0 includes diagonal
mask1 = np.tril(np.ones_like(C1, dtype=bool), k=0) # k=0 includes diagonal
# Plot heatmap
#figsize=(6, 5) # adjust fig size as needed
sns.heatmap(
C0,
mask=mask0, # apply mask
annot=True,
fmt=".2f",
cmap="coolwarm",
square=True,
linewidths=.5,#adjust as needed
annot_kws={"size": 6},#adjust as needed
cbar_kws={"shrink": .8}#adjust as needed
)
plt.title("Upper Triangular Pearson Correlation Matrix (No Diagonal)", fontsize=14)
plt.show()
#figsize=(6, 5) # adjust fig size as needed
sns.heatmap(
