# Import data
guide='C:/Users/Bee Ling/Desktop/heart.csv'
H = pd.read_csv(guide)
print(H.head(6))#check data if column is available

#check column names
H.columns

# Convert true to 1, false to 0
H['sex']=(H['sex'] !=0).astype(int)
H['fbs']=(H['fbs'] !=0).astype(int)
H['exang']=(H['exang'] !=0).astype(int)
H['class']=(H['class'] !=0).astype(int)

#Construct Correlation Matrix
C0 = H.corr(method='pearson') # pearson correlation matrix
C1 = H.corr(method='spearman') # spearman correlation matrix
# Create mask for lower triangle + diagonal
mask0 = np.tril(np.ones_like(C0, dtype=bool), k=0) # k=0 includes diagonal
mask1 = np.tril(np.ones_like(C1, dtype=bool), k=0) # k=0 includes diagonal
# Plot heatmap
#figsize=(6, 5) # remove the first "#" to adjust fig size if needed
sns.heatmap(C0, mask=mask0, annot=True, fmt=".2f", cmap="coolwarm", square=True, linewidths=.5, annot_kws={"size": 6}, 
cbar_kws={"shrink": .8}#adjust as needed)
plt.title("Upper Triangular Pearson Correlation Matrix (No Diagonal)", fontsize=14)
plt.show()
#figsize=(6, 5) # remove the first "#" to adjust fig size if needed
sns.heatmap(C1, mask=mask1, annot=True, fmt=".2f", cmap="coolwarm", square=True, linewidths=.5, annot_kws={"size": 6}, 
cbar_kws={"shrink": .8})

plt.title("Upper Triangular Spearson Correlation Matrix (No Diagonal)",fontsize=14
plt.show()

#Based on the Correlation matrix, choose top 5 predictors which are greatly correlated with class for following prediction.
#"exang" is ommited because it is binary, compared to cp, it may lead to loss of information

#Splilt the table to
X = H[['ca','thal','oldpeak','thalach','cp']]
Y = H[['class']]
#Just for checking
print(X.columns)
print(Y.columns)
print(Y.head(10))

#For application in data normalization
Xm=X.mean(numeric_only=True)# obtain mean for each predictor
print(Xm)
Xsd=X.std(numeric_only=True)# obtain standard deviation for each predictor
print(Xsd)

#Splitting data into training (train & validation set) and testing set
X_train1, X_test1, y_train, y_test = tts(X, Y, test_size=0.198, random_state=42)
#Normalize data
X_train, X_test = (X_train1 - Xm)/Xsd, (X_test1 - Xm)/Xsd

#Save train-test dataset seperately for both R and Python (change to sql database)
train = pd.concat([X_train1.reset_index(drop=True),
y_train.reset_index(drop=True)], axis=1)
train.to_csv("HEART_train.csv", index=False)
# Save testing data
test = pd.concat([X_test1.reset_index(drop=True),
y_test.reset_index(drop=True)], axis=1)
test.to_csv("HEART_test.csv", index=False)
